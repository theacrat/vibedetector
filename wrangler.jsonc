{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedetector",
  "account_id": "85cd914334836de8bb8e1f0874e11da8",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "vibedetector.net", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibedetector-community-production",
      "database_id": "a73bac50-12b3-4bb3-a427-c8207e35dad7",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMIT",
      "namespace_id": "874164",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "REPORT_RATE_LIMIT",
      "namespace_id": "874163",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFROSyaakxb3TQIa",
    "TURNSTILE_HOSTNAME": "vibedetector.net",
  },
  "triggers": { "crons": ["17 * * * *"] },
}
